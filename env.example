# All settings of the Tunga Portal. Copy this file to ".env" for your computer,
# or type the same names and values on the server:
#   DigitalOcean App Platform -> your app -> Settings -> Environment Variables
#   DigitalOcean Droplet      -> /srv/tunga/app/.env  (deploy/setup_droplet.sh writes it)
# Never put real values in this file or upload .env to GitHub.

# --- live site -------------------------------------------------------------
PRODUCTION=1                    # leave out on your computer (then DEBUG is on)
SECRET_KEY=                     # python -c "import secrets; print(secrets.token_urlsafe(50))"
SITE_DOMAIN=tungaleyte.com      # your Namecheap domain, without www
ALLOWED_HOSTS=                  # extra addresses, comma separated (e.g. the Droplet IP)
ADMIN_URL=                      # secret Django admin address, e.g. lgu-panel-x7k29q
CLIENT_IP_HEADER=               # Droplet: HTTP_X_REAL_IP   App Platform: HTTP_DO_CONNECTING_IP

# --- database ----------------------------------------------------------------
# DigitalOcean managed database:  postgresql://USER:PASSWORD@HOST:25060/DB?sslmode=require
# Droplet (local PostgreSQL):     postgresql://tunga:PASSWORD@127.0.0.1:5432/tunga
# Leave empty on your computer to use db.sqlite3
DATABASE_URL=

# --- uploaded files (photos, PDFs) -----------------------------------------
MEDIA_STORAGE=cloudinary        # cloudinary | spaces | local (local = Droplet disk only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SPACES_*: also where backups are kept (needed on App Platform, whose disk is erased on deploy)
SPACES_BUCKET=
SPACES_REGION=sgp1
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_DOMAIN=
MEDIA_ROOT=                     # MEDIA_STORAGE=local only, e.g. /srv/tunga/media
BACKUP_ROOT=                    # where backups go when not using Spaces, e.g. /srv/tunga/private_backups

# --- security keys ---------------------------------------------------------
OTP_ENCRYPTION_KEY=             # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECAPTCHA_SITE_KEY=             # https://www.google.com/recaptcha/admin (v2 "I'm not a robot")
RECAPTCHA_SECRET_KEY=

# --- default Brevo account (OTP and system emails) ------------------------------
# Shown and used automatically in Super Admin -> System Settings until another
# account is saved there. Brevo -> SMTP & API -> API Keys.
BREVO_SENDER_EMAIL=             # a sender verified in Brevo
BREVO_API_KEY=

# --- first Django superuser (created once by "manage.py setup_production") ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- optional ----------------------------------------------------------------
WEB_CONCURRENCY=2               # gunicorn workers
DJANGO_LOG_LEVEL=INFO
